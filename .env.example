# Code PLAY Studio - Environment Configuration

# OpenRouter API (required for remote model routing)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic API (optional, for direct Claude access)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# oMLX Local Server (optional, for local model routing)
OMLX_BASE_URL=http://127.0.0.1:8000
OMLX_API_KEY=your-local-key

# GitHub (for deploy service)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_OWNER=linnana8888888

# itch.io publishing (butler) — see BUTLER_SETUP.md for one-time setup
BUTLER_API_KEY=your-butler-token-here
ITCHIO_USERNAME=your-itch-handle

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false
